# Copy to .env. Mock mode performs no paid model requests.
DEV_MODE=true
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MAHTHILDIS_MODELS=gemini:gemini-3.8-flash,groq:openai/gpt-oss-120b
MAHTHILDIS_FALLBACK=openrouter:openrouter/free
CHAIRMAN_MODEL=gemini:gemini-3.8-flash
DATABASE_URL=sqlite:///data/mahthildis.db
EMBEDDING_BACKEND=hash
NLI_BACKEND=structured
QDRANT_URL=
# Optional USD/million rates, keyed by provider:model; unknown cost stays null.
MODEL_PRICES_JSON={}
# Optional local backend access token; never put provider keys in frontend config.
API_TOKEN=
PUBLIC_DEPLOYMENT=false
POSTGRES_PASSWORD=
QDRANT_API_KEY=
# For PostgreSQL: DATABASE_URL=postgresql+psycopg://mahthildis:PASSWORD@localhost:5432/mahthildis
# For ML: EMBEDDING_BACKEND=sentence-transformers; NLI_BACKEND=transformers
